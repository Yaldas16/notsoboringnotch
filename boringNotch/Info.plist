<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleAllowMixedLocalizations</key>
	<true/>
	<key>NSAudioCaptureUsageDescription</key>
	<string>NotSoBoringNotch analyzes audio from your music app to draw a real-time waveform in the notch. Audio is processed locally and never leaves your Mac.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Ask GPT</string>
			</dict>
			<key>NSServiceDescription</key>
			<string>Open an Ask GPT composer with the selected text.</string>
			<key>NSMessage</key>
			<string>askGPT</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
				<string>public.rtf</string>
				<string>NeXT Rich Text Format v1.0 pasteboard type</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict/>
	</array>
</dict>
</plist>
